# Copy to .env (already gitignored) — never commit real keys.
# The pipeline reads these via bgm_v2/config.py:Config; no fallbacks remain.
#
# 默认走云雾(yunwu) —— GPT 与 Suno 可用同一把云雾 key。
# 旧的柏拉图 api.bltcy.ai 已停服，勿再使用。

BGM_GPT_API_KEY=sk-replace-me
BGM_GPT_API_BASE=https://yunwu.ai/v1
BGM_GPT_MODEL=gpt-5.4

BGM_SUNO_API_KEY=sk-replace-me
BGM_SUNO_API_BASE=https://yunwu.ai/suno
BGM_SUNO_MODEL=chirp-v4

BGM_OUTPUT_DIR=comparison/output_new
BGM_CACHE_DIR=comparison/cache
